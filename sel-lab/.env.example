# 사내 LLM Gateway (OpenAI 호환). 이 파일을 .env로 복사해서 채운다. .env는 커밋하지 않는다.
SEL_LLM_BASE_URL=https://llm-gateway.example.internal/v1
SEL_LLM_API_KEY=
# 역할별 모델. 비우면 SEL_MODEL을 쓴다. judge는 Improver와 다른 모델을 권장 (앱 설계 6.4)
SEL_MODEL=
SEL_AGENT_MODEL=
SEL_CREATOR_MODEL=
SEL_IMPROVER_MODEL=
SEL_JUDGE_MODEL=
# 1이면 LLM 없이 규칙 기반 가짜 에이전트 + oracle Improver로 배관만 검증
SEL_OFFLINE=0
# judge 채점 사용 여부 (보정 전에는 0 권장: 규칙 채점만으로 게이트)
SEL_JUDGE_ENABLED=0
# 선택: Phoenix로 trace 보내기 (예: http://localhost:6006/v1/traces). 비우면 runs/traces/*.jsonl에만 기록
SEL_OTLP_ENDPOINT=
